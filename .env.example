# Copiar a .env para desarrollo local. Ningún valor sensible va al repositorio.

# Puerto donde escucha el proceso
PORT=4300

# Conexión a PostgreSQL 16 (con docker compose up: usuario/clave/base de abajo)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=mi_tierrita
DB_USER=mi_tierrita
DB_PASSWORD=mi_tierrita

# En un Postgres gestionado (Seenode) se define DATABASE_URL en vez de las cinco de
# arriba: postgres://usuario:clave@host:puerto/base. Tiene prioridad si está presente.
# DATABASE_URL=

# TLS de la conexión: disable | require | verify.
# Por defecto disable con variables sueltas y require con DATABASE_URL.
# DB_SSL=require

# Firma de los tokens de sesión. Mínimo 32 caracteres. Sin valor por defecto en producción.
JWT_SECRET=cambia-este-secreto-de-desarrollo-de-al-menos-32-caracteres
# Vigencia del token de acceso (formato de jsonwebtoken)
JWT_EXPIRES_IN=8h

# Orígenes del frontend permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# Zona horaria del negocio: "hoy", los cortes de los reportes y los vencimientos se cuentan en hora local
# BUSINESS_TZ=America/Bogota

# Asistente de IA (Claude, de Anthropic). Opcional: sin clave la app oculta la IA.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
# AI_FAST_MODEL=claude-haiku-5-5

# Web Push (alarmas y avisos aunque la pestaña esté cerrada). Opcional: sin el par VAPID el push queda apagado.
# Genere el par con `pnpm vapid` y pegue las dos claves aquí. VAPID_SUBJECT es un mailto: o https: de contacto.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@mitierrita.local

# Datos de ejemplo (brief de octubre de 2026, punto 39). Con true, la API ejecuta `pnpm db:seed` al arrancar:
# crea lo que falte y no toca lo que ya existe. Por defecto apagado; también se puede correr a mano.
# SEED_ON_START=false
